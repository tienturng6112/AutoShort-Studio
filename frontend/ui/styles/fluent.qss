
/* Fluent Design Base Styles */

QWidget {
    font-family: 'Segoe UI', 'Inter', 'Roboto', sans-serif;
    font-size: 13px;
    color: #1F2937;
    background-color: #F9FAFB;
}

/* Sidebar */
#Sidebar {
    background-color: #F3F4F6;
    border-right: 1px solid #E5E7EB;
}

#Sidebar QPushButton {
    text-align: left;
    padding: 10px 15px;
    border: none;
    border-radius: 6px;
    background-color: transparent;
    color: #4B5563;
    font-weight: 500;
}

#Sidebar QPushButton:hover {
    background-color: #E5E7EB;
    color: #111827;
}

#Sidebar QPushButton:checked {
    background-color: #E0E7FF;
    color: #4F46E5;
    font-weight: 600;
}

/* Top Toolbar */
#TopToolbar {
    background-color: #FFFFFF;
    border-bottom: 1px solid #E5E7EB;
}

#TopToolbar QPushButton {
    border: none;
    border-radius: 4px;
    padding: 6px 12px;
    background-color: transparent;
    color: #4B5563;
}

#TopToolbar QPushButton:hover {
    background-color: #F3F4F6;
}

/* Cards */
.Card {
    background-color: #FFFFFF;
    border: 1px solid #E5E7EB;
    border-radius: 8px;
    padding: 15px;
}

.Card:hover {
    border-color: #C7D2FE;
    background-color: #F8FAFC;
}

/* Primary Accent Buttons */
QPushButton.Primary {
    background-color: #4F46E5;
    color: #FFFFFF;
    border-radius: 6px;
    padding: 8px 16px;
    font-weight: 600;
    border: none;
}

QPushButton.Primary:hover {
    background-color: #4338CA;
}

QPushButton.Primary:pressed {
    background-color: #3730A3;
}
QPushButton.Primary:disabled {
    background-color: #A5B4FC;
    color: #E0E7FF;
}

/* Standard Buttons */
QPushButton {
    background-color: #FFFFFF;
    border: 1px solid #D1D5DB;
    border-radius: 6px;
    padding: 6px 12px;
    color: #374151;
}

QPushButton:hover {
    background-color: #F9FAFB;
    border-color: #9CA3AF;
}

QPushButton:pressed {
    background-color: #F3F4F6;
}

/* Input Fields */
QLineEdit, QComboBox, QTextEdit {
    background-color: #FFFFFF;
    border: 1px solid #D1D5DB;
    border-radius: 6px;
    padding: 6px 10px;
    color: #111827;
}

QLineEdit:focus, QComboBox:focus, QTextEdit:focus {
    border: 1px solid #4F46E5;
    outline: none;
}

/* GroupBox */
QGroupBox {
    border: 1px solid #E5E7EB;
    border-radius: 8px;
    margin-top: 10px;
    padding-top: 15px;
    font-weight: 600;
    color: #374151;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 10px;
    padding: 0 5px;
}

/* Splitter */
QSplitter::handle {
    background-color: #E5E7EB;
    width: 1px;
}

/* Tabs */
QTabWidget::pane {
    border: 1px solid #E5E7EB;
    border-radius: 6px;
    background-color: #FFFFFF;
}

QTabBar::tab {
    background-color: transparent;
    color: #6B7280;
    padding: 8px 16px;
    border: none;
    border-bottom: 2px solid transparent;
}

QTabBar::tab:hover {
    color: #111827;
}

QTabBar::tab:selected {
    color: #4F46E5;
    border-bottom: 2px solid #4F46E5;
    font-weight: 600;
}

/* Status Bar */
QStatusBar {
    background-color: #F3F4F6;
    border-top: 1px solid #E5E7EB;
    color: #6B7280;
}
